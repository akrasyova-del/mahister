# ====================================================
# SATELLITE WATCHER — Environment Variables Example
# Copy this file to .env and fill in your values
# ====================================================

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./satellite_watcher.db

# --- Space-Track.org credentials (optional, see CREDENTIALS.md) ---
SPACETRACK_USER=
SPACETRACK_PASS=

# --- CelesTrak (no auth required, used as fallback) ---
CELESTRAK_BASE_URL=https://celestrak.org

# --- Open-Meteo (no auth required) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- App settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Scheduler intervals (seconds) ---
WEATHER_UPDATE_INTERVAL=600
TLE_UPDATE_INTERVAL=3600
ASSIGNMENT_UPDATE_INTERVAL=300

# --- TLE age thresholds (hours) ---
TLE_MAX_AGE_LEO=24
TLE_MAX_AGE_LEO_MANEUVERING=6
TLE_MAX_AGE_MEO=48
TLE_MAX_AGE_GEO=72
TLE_MAX_AGE_HEO=24

# --- Mock mode (set to true to use demo data without external APIs) ---
MOCK_TLE=false
MOCK_WEATHER=false
